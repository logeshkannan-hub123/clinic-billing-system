PORT=4000
MONGODB_URI=mongodb://localhost:27017/clinic_billing_dev
NODE_ENV=development
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Leave unset unless this deployment sits behind a reverse proxy / load
# balancer (nginx, a cloud LB, etc.) — set to the number of proxy hops in
# front of the app (usually "1"), or an Express-recognized keyword/IP list:
# https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=1
